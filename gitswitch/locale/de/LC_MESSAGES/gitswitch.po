#: gitswitch/__main__.py:14
msgid "Switch between GitHub CLI accounts."
msgstr "Zwischen GitHub-CLI-Konten wechseln."

#: gitswitch/__main__.py:17
msgid "open the window (default)"
msgstr "Fenster öffnen (Standard)"

#: gitswitch/__main__.py:18
msgid "print the logged-in accounts as JSON"
msgstr "angemeldete Konten als JSON ausgeben"

#: gitswitch/__main__.py:19
msgid "activate an account"
msgstr "ein Konto aktivieren"

#: gitswitch/__main__.py:22
msgid "run the MCP server on stdio"
msgstr "MCP-Server über stdio starten"

#: gitswitch/__main__.py:36
#, python-brace-format
msgid "gitswitch: {error}"
msgstr "gitswitch: {error}"

#: gitswitch/core.py:64 gitswitch/core.py:415
#, python-brace-format
msgid "'{command}' was not found in PATH"
msgstr "'{command}' wurde nicht im PATH gefunden"

