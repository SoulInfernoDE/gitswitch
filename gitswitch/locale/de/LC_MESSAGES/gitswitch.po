#, python-brace-format
msgid "'{user}' exists on several hosts; pass a hostname"
msgstr "'{user}' existiert auf mehreren Hosts; bitte Hostnamen angeben"

#: gitswitch/core.py:303
#, python-brace-format
msgid ""
"{host} is a Forgejo or Gitea server. The GitHub CLI (gh) only works with "
"GitHub.com and GitHub Enterprise Server, so this account cannot be added."
msgstr ""
"{host} ist ein Forgejo- oder Gitea-Server. Die GitHub CLI (gh) funktioniert "
"nur mit GitHub.com und GitHub Enterprise Server, deshalb lässt sich dieses "
"Konto nicht hinzufügen."

